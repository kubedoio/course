# Copy to .env before production use and change all secrets.

PUBLIC_ORIGIN=http://lab.localhost:8080
LAB_DIRECT_PORT=9998
GATEWAY_PORT=8080

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.6.1
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:latest
OAUTH2_PROXY_CLIENT_ID=browser-lab-oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=change-this-client-secret
# Must be 16, 24, or 32 bytes base64 encoded. Replace for any shared environment.
OAUTH2_PROXY_COOKIE_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
