# Copy to .env and change all secrets before any shared / external use.

# ------------------------------------------------------------------------------
# Public Origin (REQUIRED for external / reverse-proxy access)
# ------------------------------------------------------------------------------
# This must be the full URL that users type into their browser.
# Examples:
#   Local dev:  http://lab.localhost:8080
#   External:   http://203.0.113.10:8080
#   With proxy: https://lab.example.com
# ------------------------------------------------------------------------------
PUBLIC_ORIGIN=http://lab.localhost:8080

LAB_DIRECT_PORT=9998
GATEWAY_PORT=8080

# ------------------------------------------------------------------------------
# Keycloak
# ------------------------------------------------------------------------------
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.6.1
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# ------------------------------------------------------------------------------
# OAuth2 Proxy
# ------------------------------------------------------------------------------
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:latest
OAUTH2_PROXY_CLIENT_ID=browser-lab-oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=change-this-client-secret

# Must be 16, 24, or 32 bytes base64 encoded. Replace for any shared environment.
OAUTH2_PROXY_COOKIE_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Set to "true" when PUBLIC_ORIGIN uses HTTPS (e.g. behind a TLS reverse proxy).
# Leaving it "false" is required for HTTP-only deployments.
OAUTH2_PROXY_COOKIE_SECURE=false

# Browser VM network relay. The default image listens on port 80 and requires
# NET_ADMIN plus /dev/net/tun, configured in docker-compose.yml.
V86_RELAY_IMAGE=bellenottelling/websockproxy:latest
